
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ CÔNG VIỆC"
            android:textColor="#17365D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline-First Task Manager"
            android:textColor="#65758B"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên công việc"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:padding="12dp"
            android:backgroundTint="#4263EB"/>

        <EditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả công việc"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="1"
            android:maxLines="3"
            android:padding="12dp"
            android:backgroundTint="#4263EB"/>

        <Button
            android:id="@+id/btnAddTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÊM CÔNG VIỆC"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnCheckServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KIỂM TRA SERVER"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ĐỒNG BỘ NGAY"
            android:layout_marginTop="8dp"/>


        <TextView
            android:id="@+id/tvSyncInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chế độ lưu trữ: Room Offline"
            android:textColor="#32724F"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvTaskCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Danh sách công việc (0)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:layout_marginTop="18dp"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTasks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topPanel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa có công việc nào.\nHãy thêm công việc đầu tiên!"
        android:textColor="#65758B"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvTasks"
        app:layout_constraintBottom_toBottomOf="@id/rvTasks"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
